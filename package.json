{
  "name": "mux-xr",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4240 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4240 --strictPort",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.node.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings .",
    "fmt": "biome format --write .",
    "e2e": "bun run scripts/e2e.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@par/xr-workspace": "workspace:*",
    "@xterm/xterm": "6.0.0",
    "libheif-js": "1.23.5",
    "onnxruntime-node": "1.31.1",
    "pako": "3.0.3",
    "sharp": "0.35.5",
    "three": "0.187.0",
    "troika-three-text": "0.54.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "26.6.11",
    "@types/three": "0.187.0",
    "@types/webxr": "0.5.24",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.2",
    "fast-check": "4.11.0",
    "happy-dom": "21.0.4",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "workspaces": [
    "packages/xr-workspace"
  ]
}
